{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm test*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npx vitest *)",
      "Bash(npm run check:docs*)",
      "Bash(npm run example*)",
      "Bash(npm pack --dry-run*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh run watch*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh release list -R *)",
      "Bash(gh release view -R *)",
      "Bash(gh project view*)",
      "Bash(gh project item-list*)",
      "Bash(gh project field-list*)",
      "Bash(gh ruleset list*)",
      "Bash(gh ruleset view*)",
      "Bash(gh ruleset check*)",
      "Bash(gh variable list*)",
      "Bash(gh secret list*)",
      "Bash(gh label list*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr review *)",
      "Bash(gh pr close *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh project item-add *)",
      "Bash(gh workflow run agent-pipeline.yml*)",
      "Bash(gh workflow run agent-fix.yml*)",
      "Bash(gh workflow run dispatch.yml*)",
      "Bash(gh run rerun *)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin chore/*)"
    ],
    "deny": [
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease origin main*)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh release delete *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api */rulesets*)",
      "Bash(gh api */protection*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-signals.mjs\""
          }
        ]
      }
    ]
  }
}
